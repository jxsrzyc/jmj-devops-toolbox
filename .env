# ===== 数据库配置 =====
# DB_ENGINE: sqlite | mysql（同一套代码双模式切换）
DB_ENGINE=mysql

# MySQL 连接配置（DB_ENGINE=mysql 时生效）
DB_HOST=mysql-dev-001.datousoft.com
DB_PORT=3306
DB_USER=ops_toolbox
DB_PASS=a3n@tzAURv4cEGds
DB_NAME=ops_toolbox

# SQLite 配置（DB_ENGINE=sqlite 时生效）
# DB_PATH=data.db

# ===== LDAP 配置 =====
LDAP_ENABLE=true
LDAP_HOST=ldap.jiumaojiu.com
LDAP_PORT=636
LDAP_BASE_DN=dc=jiumaojiu,dc=com
LDAP_BIND_USER=cn=admin,dc=jiumaojiu,dc=com
LDAP_BIND_PASS=jmj1995.com
# openldap 格式 e.g. (&(uid=%s)) / AD 格式 e.g. (&(sAMAccountName=%s))
LDAP_AUTH_FILTER=(&(objectClass=inetOrgPerson)(uid=%s))
LDAP_USER_FILTER=(&(objectClass=inetOrgPerson)(uid=%s))
LDAP_TLS=true
LDAP_STARTTLS=true
# LDAP 用户默认权限（首次登录自动开通，默认仅发版管理）
LDAP_DEFAULT_PERMS=release

# ===== 凭证密码加密 =====
# Fernet 密钥（AES-128-CBC + HMAC），生产环境务必自定义，泄漏=密码可解密
CRED_SECRET_KEY=HQWHMHQGUOiT0XvTDfLRDRRsMOPjgB9xtvWCZX3ueUw=
